# Optional on a local Wi-Fi network: Expo detects the development computer's host.
# Set an address reachable by your phone when using an Expo tunnel or a hosted API.
EXPO_PUBLIC_API_URL=http://localhost:8000

# Optional: WebSocket URL is derived from EXPO_PUBLIC_API_URL by default.
# EXPO_PUBLIC_WS_URL=wss://your-api.example.com/api/v1/chat/stream
