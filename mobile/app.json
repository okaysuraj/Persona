{
  "expo": {
    "name": "Persona",
    "slug": "persona-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "persona",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#121211"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.persona.ai",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Persona requires microphone access for voice messages and live duplex audio calls with your companion."
      }
    },
    "android": {
      "package": "com.persona.ai",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#121211"
      },
      "permissions": [
        "RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-asset",
      "expo-secure-store",
      "expo-audio"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
